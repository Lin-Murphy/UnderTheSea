  m_Script: {fileID: 11500000, guid: a1b00340083fd7840b54494ce1adef1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UnderTheSea.BreathGuide
  controller: {fileID: 423221052}
  voiceOver: {fileID: 423221040}
  soundscape: {fileID: 423221041}
  viewer: {fileID: 462379092}
  textMaterial: {fileID: 2100000, guid: 7f81adc550729334b928467e3f999a81, type: 2}
  promptCueId: 05
  releaseClip: {fileID: 8300000, guid: 7ab408952b7bd4145b722cee549e434e, type: 3}
  releaseStart: 5.49
  releaseEnd: 7.29
  releaseGain: 3.05
  releaseText: Now you can breathe normally.
  holdText: Hold
  holdDelay: 1
  fadeInSeconds: 1
  fadeOutSeconds: 1.5
