--- !u!114 &675283045
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 675283042}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 97fb35b413759fe48a07ecf51a40a11a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UnderTheSea.ReefVoiceOver
  controller: {fileID: 675283057}
  view: {fileID: 675283053}
  soundscape: {fileID: 675283046}
  seaweed: {fileID: 61073631}
  cues:
  - id: 01
    text: 'Welcome to Ultrasound Wonders: Under the Sea. Make yourself comfortable.
      Here, you are a coral, resting gently beneath the waves. For now, breathe normally.
      Follow your clinician''s instructions, and let them know if you need a pause.'
    clip: {fileID: 8300000, guid: daeadf710b814284ba1973782f0fbb5f, type: 3}
    stage: 1
    trigger: 1
    delay: 1
    afterId: 
    fallback: 0
    gain: 2.69
    clipStart: 0
    clipEnd: 0
  - id: 02
    text: A gentle wave passes over you. Some little fish have come to say hello.
    clip: {fileID: 8300000, guid: d4fe230841c2d1e46b9c75db660541ff, type: 3}
    stage: 2
    trigger: 0
    delay: 1
    afterId: 
    fallback: 0
    gain: 2.37
    clipStart: 0
    clipEnd: 0
  - id: 03
    text: A little clownfish nestles close as the seagrass gently rests against you.
      You may feel a little pressure.
    clip: {fileID: 8300000, guid: 4d9be2c834e41d247be71a7511f9fdbc, type: 3}
    stage: 3
    trigger: 5
    delay: 0.3
    afterId: 
    fallback: 3
    gain: 2.84
    clipStart: 0
    clipEnd: 0
  - id: 04
    text: Night is falling over the reef, the little fish nestle among your coral
      branches. Let's help the jellyfish's gentle light grow.
    clip: {fileID: 8300000, guid: 577312cf1ce2cf74c8986dda9fd6c031, type: 3}
    stage: 4
    trigger: 0
    delay: 0.5
    afterId: 
    fallback: 0
    gain: 2.62
    clipStart: 0
    clipEnd: 0
  - id: 05
    text: Take a slow breath in, as deeply as feels comfortable. Watch the jellyfish
      grow and glow.
    clip: {fileID: 8300000, guid: 3d49627ee53e6ab4b937a4ea6c032f9c, type: 3}
    stage: 5
    trigger: 0
    delay: 1
    afterId: 
    fallback: 0
    gain: 3.38
    clipStart: 0
    clipEnd: 0
  - id: 06a
    text: Gently hold for a moment. The light rests with you.
    clip: {fileID: 8300000, guid: 7ab408952b7bd4145b722cee549e434e, type: 3}
    stage: 5
    trigger: 3
    delay: 2
    afterId: 05
    fallback: 20
    gain: 3.05
    clipStart: 0
    clipEnd: 4.27
  - id: 06b
    text: Perfect. Now you can breathe normally.
    clip: {fileID: 8300000, guid: 7ab408952b7bd4145b722cee549e434e, type: 3}
    stage: 5
    trigger: 6
    delay: 0.3
    afterId: 06a
    fallback: 0
    gain: 3.05
    clipStart: 4.27
    clipEnd: 7.29
  - id: 06c
    text: Let's try it again. Take a slow breath in, then hold.
    clip: {fileID: 8300000, guid: 7ab408952b7bd4145b722cee549e434e, type: 3}
    stage: 5
    trigger: 2
    delay: 5
    afterId: 06b
    fallback: 0
    gain: 3.05
    clipStart: 7.29
    clipEnd: 13.25
  - id: 06d
    text: Wonderful. You can breathe normally now.
    clip: {fileID: 8300000, guid: 7ab408952b7bd4145b722cee549e434e, type: 3}
    stage: 5
    trigger: 6
    delay: 0.3
    afterId: 06c
    fallback: 0
    gain: 3.05
    clipStart: 13.25
    clipEnd: 0
  - id: 07
    text: You can breathe normally now. The light spreads softly around the little
      fish.
    clip: {fileID: 8300000, guid: b793be2788df68f4f99b8dae43a68a91, type: 3}
    stage: 6
    trigger: 0
    delay: 0.5
    afterId: 
    fallback: 0
    gain: 2.87
    clipStart: 0
    clipEnd: 0
  - id: 08
    text: Our underwater journey is coming to an end. Thank you for sharing this
      little ocean with us. Gently bring your attention back to the room. Keep resting
      while we help you remove the headset.
    clip: {fileID: 8300000, guid: 033837a9ee18c9a4f9e1800af98d2010, type: 3}
    stage: 8
    trigger: 0
    delay: 0.3
    afterId: 
    fallback: 0
    gain: 2.28
    clipStart: 0
    clipEnd: 0
  volume: 1
